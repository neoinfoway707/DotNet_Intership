@model List<AppointmentViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Patient Name</th>
            <th>Appointment Time</th>
            <th>Reason</th>
            <th>Doctor</th>
            <th>Specialization</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.PatientName)</td>
                <td>@Html.DisplayFor(modelItem => item.AppointmentTime)</td>
                <td>@Html.DisplayFor(modelItem => item.Reason)</td>
                <td>@item.doctor.Name</td>
                <td>@item.doctor.Specialization</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id"
                       onclick="return confirm('Are you sure you want to Delete this appointment.');">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
