@* @{
    ViewData["Title"] = "Partial View";
} *@
@model Employee

<form id="empForm">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="Id" id="empId" />

    <div class="form-group mb-2">
        <label asp-for="Name" class="control-label"></label>
        <input asp-for="Name" class="form-control" id="empName" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="Email" class="control-label"></label>
        <input asp-for="Email" class="form-control" id="empEmail" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="Department" class="control-label"></label>
        <input asp-for="Department" class="form-control" id="empDepartment" />
        <span asp-validation-for="Department" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="Designation" class="control-label"></label>
        <input asp-for="Designation" class="form-control" id="empDesignation" />
        <span asp-validation-for="Designation" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="JoiningDate" class="control-label"></label>
        <input asp-for="JoiningDate" class="form-control" id="empJoiningDate" />
        <span asp-validation-for="JoiningDate" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="Salary" class="control-label"></label>
        <input asp-for="Salary" class="form-control" id="empSalary" />
        <span asp-validation-for="Salary" class="text-danger"></span>
    </div>
</form>