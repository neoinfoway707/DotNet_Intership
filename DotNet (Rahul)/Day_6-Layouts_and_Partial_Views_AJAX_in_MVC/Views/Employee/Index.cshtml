@model List<Employee>

@{
    ViewData["Title"] = "Index";
}

<h1>Employee Management</h1>

<p>
    <button class="btn btn-success" id="createNewEmp">Create New </button>
</p>

@if(Model != null){
    <table class="table">
        <thead>
            <tr>
                <th>Employee Name</th>
                <th>Email</th>
                <th>Department</th>
                <th>Designation</th>
                <th>JoiningDate</th>
                <th>Salary</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                    <td>@Html.DisplayFor(modelItem => item.Email)</td>
                    <td>@Html.DisplayFor(modelItem => item.Department)</td>
                    <td>@Html.DisplayFor(modelItem => item.Designation)</td>
                    <td>@Html.DisplayFor(modelItem => item.JoiningDate)</td>
                    <td>@Html.DisplayFor(modelItem => item.Salary)</td>
                    <td>
                        <a class="edit_btn" href="#" data-id="@item.Id">Edit</a> |
                        <a class="delete_btn" href="#" data-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="modal fade " id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg"> 
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Employee Record</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="editModelBody">
                @await Html.PartialAsync("_EmployeePartial",new Employee())
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="createBtn">Add</button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>

        $(document).ready(function() {
             var modalMode = "";

            //Edit Employee
            $(".edit_btn").click(function(e) {
                e.preventDefault();
                 modalMode = "edit";
        
                $("#createModal .modal-title").text("Edit Employee Record");
                $("#createBtn").text("Update");

                var empId = $(this).data("id");

                $.ajax({
                    type: "GET",
                    url: "@Url.Action("Edit")",
                    data: {id: empId},
                    dataType : "json",
                    success: function(result){
                        $("#empId").val(result.id);
                        $("#empName").val(result.name);
                        $("#empEmail").val(result.email);
                        $("#empDepartment").val(result.department);
                        $("#empDesignation").val(result.designation);

                        var date = new Date(result.joiningDate);
                        var formatted = date.toISOString().split('T')[0];
                        $("#empJoiningDate").val(formatted);

                        $("#empSalary").val(result.salary);

                        var modal = new bootstrap.Modal(document.getElementById('createModal'));
                        modal.show();
                    },
                    error: function(req,status,error){
                        alert("Failes to load employee data.");
                    }
                })
            });

            //create model open
            $("#createNewEmp").click(function(){
                modalMode = "create";
                $("#createModal .modal-title").text("Create New Employee");
                $("#createBtn").text("Add");

                $("#empForm")[0].reset();
                $("#empId").val(0);
                var modal = new bootstrap.Modal(document.getElementById('createModal'));
                modal.show();
            });

            //Save Record
            $("#createBtn").click(function(){


                var emp = {
                    Id: $("#empId").val(),
                    Name: $("#empName").val(),
                    Email: $("#empEmail").val(),
                    Department: $("#empDepartment").val(),
                    Designation: $("#empDesignation").val(),
                    JoiningDate: $("#empJoiningDate").val(),
                    Salary: $("#empSalary").val()
                }

                if(modalMode == "create"){
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("Create","Employee")",
                        data: emp,
                        success: function(result){
                            if(result.success){
                                bootstrap.Modal.getInstance(document.getElementById("createModal")).hide();
                                location.reload();
                            }else{
                                alert("Error: "+result.message);
                            }
                        },
                        error:function(req,status,error){
                            alert("Failed to Save changes.");
                        }
                    });
                }
                else if(modalMode == "edit"){

                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("Edit","Employee")",
                        data: {Id: emp.Id, employee: emp},
                        success: function(result){
                            if(result.success){
                                bootstrap.Modal.getInstance(document.getElementById("createModal")).hide();
                                location.reload();
                            }else{
                                alert("Error: "+result.message);
                            }
                        },
                        error:function(req,status,error){
                            alert("Failed to Save changes.");
                        }
                    });
                }
            });
          $(".delete_btn").click(function(e){
                 e.preventDefault();

                var confirmDelete = confirm("Are you sure you want to delete this record?");
                if (!confirmDelete) return false; 

                var empId = $(this).data("id");
    
                 $.ajax({
                     type:"POST",
                     url: "@Url.Action("DeleteConfirmed", "Employee")",
                     data: {id: empId},
                     success: function(result){
                         if (result.success) {
                             location.reload();
                         }else{
                             alert("Error: " + result.message);
                         }
                     },
                     error: function(){
                         alert("Failed to delete employee.");
                     }
                 });
             });
        });
    </script>
}
