@model User
@{
    ViewData["Title"] = "Registration Page";
}
<h1>Register</h1>
@using (Html.BeginForm("Register", "Home", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        @Html.LabelFor(m => m.Name, new { @class = "form-label mt-1" })
        @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.Name, "", new { @class = "text-danger position-absolute" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Age, new { @class = "form-label mt-4" })
        @Html.TextBoxFor(m => m.Age, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.Age, "", new { @class = "text-danger position-absolute" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Email, new { @class = "form-label mt-4" })
        @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.Email, "", new { @class = "text-danger position-absolute" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Password, new { @class = "form-label mt-4" })
        @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.Password, "", new { @class = "text-danger position-absolute" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label mt-4" })
        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.ConfirmPassword, "", new { @class = "text-danger position-absolute" })
    </div>
    <button type="submit" class="btn btn-primary mt-5">Register</button>
}