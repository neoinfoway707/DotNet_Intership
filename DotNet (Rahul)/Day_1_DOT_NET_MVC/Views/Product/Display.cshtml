@model List<Product>
@{
    ViewData["Title"] = "Display Product Record.";
}
@section title {
    <h2>All Product Details</h2>
}
@if (Model != null && Model.Count > 0)
{
    <table class="table table-striped table-hover table-light table-responsive">
        <thead>
            <tr>
                <th>Id</th>
                <th>Product Name</th>
                <th>Price</th>
                <th>Category</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Product product in Model)
            {
                <tr>
                    <td>@product.Id</td>
                    <td>@product.ProductName</td>
                    <td>$@product.Price</td>
                    <td>@product.Category</td>
                    <td>
                        <a class="btn btn-link" asp-controller="Product"
                           asp-action="Update" asp-route-id="@product.Id">Edit</a> |
                        <a class="btn btn-link" asp-controller="Product"
                           asp-action="Delete" asp-route-id="@product.Id"
                           onclick="return confirmDelete();">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
<p>No product details available.</p>
}
<a class="btn btn-primary mt-3" asp-controller="Product" asp-action="Create">Add New</a>

@section scripts {
    <script>
        function confirmDelete() {
            return confirm("Are you sure you want to delete this product?");
        }
    </script>
}