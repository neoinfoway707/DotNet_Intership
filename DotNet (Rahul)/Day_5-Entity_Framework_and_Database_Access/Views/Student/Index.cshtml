@model List<Student>
@{
    ViewData["Title"] = "Studnet Deatisl";
}
<div class="container mt-4">
    <h2>Student Management</h2>
            @if(Model != null && Model.Count > 0){

    <table class="table table-striped table-hover table-responsive">
        <thead>
            <tr>
                <th>Student Name</th>
                <th>Email Address</th>
                <th>Course</th>
                <th>Class</th>
                <th>Tuation Fee</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (Student student in Model)
            {
                <tr>
                    <td>@student.Name</td>
                    <td>@student.Email</td>
                    <td>@student.Course</td>
                    <td>@student.Class</td>
                    <td>@student.TuationFee</td>
                    <td>
                        @Html.ActionLink("Edit", "Update", "Student", new { id = student.Id }, new { @class = "btn-link" })
                        @Html.ActionLink("Delete", "Delete", "Student", new { id = student.Id }, 
                        new { 
                            @class = "btn-link", 
                            onclick = "return confirm(`Are you sure you want to delete this student?`);"
                        })
                    </td>
                </tr>
            }
        </tbody>
    </table>
    }     
    else
    {
        <div class="alert alert-info shadow-sm rounded p-4 text-center mt-3" role="alert">
                <h4 class="alert-heading">No Records Found!</h4>
                <p class="mb-0 text-muted">There are currently no students registered in the system.</p>
                <hr>
                <p class="mb-0">Click the <strong>Add New Student</strong> button above to create your first record.</p>
        </div>
    }
    @Html.ActionLink("Add", "Create", "Student" ,null,new { @class = "btn btn-primary" })
</div>
