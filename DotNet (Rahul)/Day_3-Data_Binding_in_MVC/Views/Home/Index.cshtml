@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-4">
    <h1 class="display-4">Welcome to Our Site!!</h1>

    <div class="alert alert-info">
        <strong>Info:</strong> @ViewData["Message"]
        <small class="text-muted">Current Time: @ViewData["CurrentTime"]</small>
    </div>
    <div class="alert alert-warning">
        <strong>Warning:</strong> @ViewBag.Greeting
    </div>
    <div class="alert alert-danger">
        <strong>Error:</strong> @TempData.Peek("Notice")
    </div>
</div>
